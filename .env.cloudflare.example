# Cloudflare Environment Variables Template
# Copy this file to .dev.vars for local development
# Set these in Cloudflare Dashboard for production

# ============================================================================
# Application Settings
# ============================================================================
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=false

# ============================================================================
# Security & Authentication
# ============================================================================

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your-secret-key-here

# OAuth2 Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session Settings
SESSION_DURATION=86400  # 24 hours in seconds
REFRESH_TOKEN_DURATION=2592000  # 30 days in seconds

# ============================================================================
# Database Configuration
# ============================================================================

# Cloudflare D1 database IDs are configured in wrangler.toml
# These are fallback/override values if needed
# DB_CONNECTION_STRING=

# ============================================================================
# Storage Configuration
# ============================================================================

# Max upload size (bytes)
MAX_FILE_SIZE=104857600  # 100MB

# Allowed audio formats (comma-separated)
ALLOWED_AUDIO_FORMATS=mp3,wav,flac,ogg,m4a,aac,opus,wma

# Storage cleanup settings
TEMP_FILE_RETENTION=3600  # 1 hour in seconds
PROCESSED_FILE_RETENTION=2592000  # 30 days in seconds

# ============================================================================
# Audio Processing
# ============================================================================

# Processing quality presets
DEFAULT_QUALITY=balanced  # fast, balanced, high

# Processing timeout (seconds)
MAX_PROCESSING_TIME=300  # 5 minutes

# Sample rates
DEFAULT_SAMPLE_RATE=44100
SUPPORTED_SAMPLE_RATES=22050,44100,48000,96000

# Concurrent processing jobs per user
MAX_CONCURRENT_JOBS=3

# ============================================================================
# Rate Limiting
# ============================================================================

# API rate limits (requests per minute)
RATE_LIMIT_FREE=10
RATE_LIMIT_PRO=100
RATE_LIMIT_ADMIN=1000

# Processing quotas (minutes per month)
PROCESSING_QUOTA_FREE=60
PROCESSING_QUOTA_PRO=600
PROCESSING_QUOTA_ADMIN=unlimited

# Upload quotas (bytes per month)
UPLOAD_QUOTA_FREE=1073741824  # 1GB
UPLOAD_QUOTA_PRO=10737418240  # 10GB
UPLOAD_QUOTA_ADMIN=unlimited

# ============================================================================
# External Services
# ============================================================================

# OpenAI API (for AI features)
OPENAI_API_KEY=

# Cloudflare AI Workers (automatically available in Workers)
# No configuration needed - uses binding

# Sentry (error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Analytics
ANALYTICS_ENABLED=false
ANALYTICS_SAMPLE_RATE=0.1  # 10% sampling

# ============================================================================
# Email Configuration
# ============================================================================

# Email service (for notifications)
EMAIL_FROM=noreply@jamsplitter.com
EMAIL_REPLY_TO=support@jamsplitter.com

# SendGrid, Mailgun, or Cloudflare Email Workers
EMAIL_PROVIDER=cloudflare
EMAIL_API_KEY=

# ============================================================================
# Content Security
# ============================================================================

# Anti-piracy
WATERMARKING_ENABLED=true
FINGERPRINTING_ENABLED=true

# Content moderation
CONTENT_SCANNING_ENABLED=true
PROFANITY_FILTER_ENABLED=true

# DMCA compliance
DMCA_EMAIL=dmca@jamsplitter.com

# ============================================================================
# Feature Flags
# ============================================================================

# Feature toggles
FEATURE_LYRICS_GENERATION=true
FEATURE_STEM_SEPARATION=true
FEATURE_REAL_TIME_PREVIEW=true
FEATURE_COLLABORATION=true
FEATURE_API_ACCESS=true

# Beta features
BETA_AI_MASTERING=false
BETA_MIDI_EXPORT=false
BETA_PLUGIN_SYSTEM=false

# ============================================================================
# CORS Configuration
# ============================================================================

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://jamsplitter.com

# CORS settings
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ============================================================================
# Monitoring & Observability
# ============================================================================

# Logging
LOG_FORMAT=json
LOG_REQUESTS=true
LOG_RESPONSES=false  # Can be verbose

# Metrics
METRICS_ENABLED=true
METRICS_ENDPOINT=/metrics

# Health checks
HEALTH_CHECK_INTERVAL=30  # seconds

# ============================================================================
# Development Settings
# ============================================================================

# Hot reload
HOT_RELOAD=true

# Debug mode
DEBUG_SQL=false
DEBUG_AUDIO_PROCESSING=false

# Sample data
USE_MOCK_DATA=false
SEED_DATABASE=false

# ============================================================================
# Production Overrides
# ============================================================================

# Set these in Cloudflare Dashboard for production:
# - ENVIRONMENT=production
# - DEBUG=false
# - LOG_LEVEL=warn
# - All security keys and secrets
# - External service API keys
# - Rate limits and quotas as needed

# ============================================================================
# Custom Domain Configuration
# ============================================================================

# Custom domain settings (configured in Cloudflare)
# DOMAIN=jamsplitter.com
# API_SUBDOMAIN=api.jamsplitter.com
# CDN_SUBDOMAIN=cdn.jamsplitter.com
